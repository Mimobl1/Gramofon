rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for data validation
    function isValidAlbum(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('author' in data) || (data.author is string && data.author.size() <= 200))
        && (!('folder' in data) || (data.folder is string && data.folder.size() <= 500))
        && (!('tracks' in data) || (data.tracks is list && data.tracks.size() <= 200))
        && (!('color' in data) || (data.color is string && data.color.size() <= 30))
        && (!('genre' in data) || (data.genre is string && data.genre.size() <= 100))
        && (!('year' in data) || (data.year is string && data.year.size() <= 50))
        && (!('order' in data) || data.order is number)
        && (!('useCustomCover' in data) || data.useCustomCover is bool)
        && (!('customCover' in data) || (data.customCover is string && data.customCover.size() <= 950000))
        && (!('cover' in data) || (data.cover is string && data.cover.size() <= 1000))
        && (!('id' in data) || (data.id is string && data.id.size() <= 200))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // Albums collection: public read, validated write
    match /albums/{albumId} {
      allow read: if true;
      allow create, update: if isValidAlbum(request.resource.data);
      allow delete: if true;
    }

    // Deleted albums tombstone records
    match /deleted_albums/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string;
      allow delete: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // User-specific Cloudflare R2 configurations
    match /users_r2/{userId} {
      allow read, write: if true;
    }
  }
}

